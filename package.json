{
  "name": "pokesurvivor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/data/build-search-index.mjs && node --env-file-if-exists=.env.local scripts/seo/build-manifest.mjs",
    "prebuild": "node scripts/data/build-search-index.mjs && node --env-file-if-exists=.env.local scripts/seo/build-manifest.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/seo/verify-output.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --env-file-if-exists=.env.local scripts/seo/build-manifest.mjs && next typegen && tsc --noEmit",
    "data:refresh": "node scripts/data/refresh-official.mjs",
    "data:check-official": "node scripts/data/check-official.mjs",
    "audit": "node scripts/audit/game-mechanics.mjs && node scripts/audit/guide-content.mjs && node scripts/audit/leaderboards.mjs && node scripts/audit/collection-previews.mjs && node scripts/audit/unpacked-game.mjs && node scripts/audit/site.mjs && node --test scripts/audit/seo.test.mjs scripts/audit/indexnow.test.mjs scripts/audit/current-content.test.mjs scripts/audit/tier-recommendations.test.mjs",
    "audit:guides": "node scripts/audit/guide-content.mjs",
    "test:mechanics": "node scripts/audit/game-mechanics.mjs && node --test scripts/audit/current-content.test.mjs scripts/audit/tier-recommendations.test.mjs",
    "data:unpack": "node scripts/data/unpack-local-game.mjs",
    "data:collection-previews": "node scripts/data/export-collection-previews.mjs",
    "data:boss-rewards": "node scripts/data/extract-boss-rewards.mjs",
    "content:sync": "node --env-file-if-exists=.env.local scripts/seo/build-manifest.mjs",
    "content:check": "node --env-file-if-exists=.env.local scripts/seo/build-manifest.mjs --check",
    "test:seo": "node --test scripts/audit/seo.test.mjs scripts/audit/indexnow.test.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
